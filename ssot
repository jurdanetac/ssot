if $PROGRAM_NAME == __FILE__
  options = {}
  OptionParser.new do |opts|
    opts.banner = 'Usage: ssot [options]'

    opts.on('-s', '--ssot FILE', 'Source of truth') do |s|
      options[:ssot] = s
    end
    opts.on('-r', '--render TARGET', 'Render target(s)') do |r|
      raise ArgumentError, 'Render and clean are mutually exclusive' if options.include? :clean

      options[:render] = r
    end
    opts.on('-c', '--clean TARGET', 'Remove rendered templates in target') do |c|
      raise ArgumentError, 'Render and clean are mutually exclusive' if options.include? :render

      options[:clean] = c
    end
    opts.on('-h', '--help', 'Prints this help') do
      puts opts
      exit
    end
  end.parse!

